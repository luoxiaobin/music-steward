    "1.2_no_library_file": {
      "library": "beets.library.Library(':memory:', set_music_dir=False)",
      "required_setting": "create_backup_before_migrations: no",
      "finding": "With the default config, constructing Library(':memory:') writes 11 sqlite backup files named ':memory:-before-<table>-<migration>.bak' (53 KB each) into the CWD and prints 'Created database backup at ...' to stdout. Found on the first smoke run, files deleted; the harness now sets create_backup_before_migrations=False. The Python audit hook did NOT see those writes (sqlite backup API writes from C), which is why every job also runs in an empty CWD with before/after directory diffs.",
      "watched_dirs": "job CWD (empty temp dir), BEETSDIR (empty temp dir), ~/.config/beets, every source dir",
      "per_job": {
        "neg_A": {
          "python_level_events": {
            "subprocess": [
              "ffmpeg"
            ]
          },
          "dir_diffs": {}
        },
        "neg_B": {
          "python_level_events": {},
          "dir_diffs": {}
        },
